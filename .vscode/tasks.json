{
  "version": "2.0.0",

  "tasks": [
    {
      "label": "Nix: Lint current file",
      "type": "shell",
      "command": "statix",
      "args": [
        "check",
        "${file}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Nix: Fix current file",
      "type": "shell",
      "command": "statix",
      "args": [
        "fix",
        "${file}"
      ],
      "problemMatcher": []
    }
  ]
}